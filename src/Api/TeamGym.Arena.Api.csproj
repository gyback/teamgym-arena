<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The single ASP.NET Core host that composes every module (ADR-0004). -->

  <!--
    Every build exports the OpenAPI 3.1 contract to openapi.json (ADR-0005), from which `npm run generate:api` in
    src/Web generates the SPA's types. Commit both files: CI fails when either differs from what the build produces.
  -->
  <PropertyGroup>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The exported contract is a build output for the SPA, not a file the host serves or publishes. -->
    <Content Remove="openapi.json" />
    <None Include="openapi.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TeamGym.Arena.Api.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Common/TeamGym.Arena.Common.csproj" />
    <ProjectReference Include="../ServiceDefaults/TeamGym.Arena.ServiceDefaults.csproj" />
    <ProjectReference Include="../Modules/Users/TeamGym.Arena.Modules.Users/TeamGym.Arena.Modules.Users.csproj" />
    <ProjectReference Include="../Modules/Organisations/TeamGym.Arena.Modules.Organisations/TeamGym.Arena.Modules.Organisations.csproj" />
    <ProjectReference Include="../Modules/Competitions/TeamGym.Arena.Modules.Competitions/TeamGym.Arena.Modules.Competitions.csproj" />
    <ProjectReference Include="../Modules/Applications/TeamGym.Arena.Modules.Applications/TeamGym.Arena.Modules.Applications.csproj" />
    <ProjectReference Include="../Modules/Scheduling/TeamGym.Arena.Modules.Scheduling/TeamGym.Arena.Modules.Scheduling.csproj" />
  </ItemGroup>

</Project>
